{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@wisdom-island/home": ["packages/home/src"],
      "@wisdom-island/search": ["packages/search/src"],
      "@wisdom-island/cloud": ["packages/cloud/src"],
      "@wisdom-island/island": ["packages/island/src"],
      "@wisdom-island/admin": ["packages/admin/src"]
    }
  },
  "exclude": ["node_modules"]
}

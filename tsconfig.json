{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "files": [],
  "include": [],
  "references": [
    { "path": "./packages/admin" },
    { "path": "./packages/cloud" },
    { "path": "./packages/explore" },
    { "path": "./packages/island" },
    { "path": "./packages/search" }
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
